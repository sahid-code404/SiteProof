POSTGRES_DB=siteproof
POSTGRES_USER=siteproof
POSTGRES_PASSWORD=siteproof_dev_password
DATABASE_URL=postgresql+psycopg://siteproof:siteproof_dev_password@postgres:5432/siteproof
JWT_SECRET=change-this-in-real-deployments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

VERIFICATION_SESSION_TTL_MINUTES=15
SESSION_START_GRACE_SECONDS=120
CAPTURE_MIN_SECONDS=8
CAPTURE_MAX_SECONDS=60
LOCATION_FRESHNESS_SECONDS=10
PREFERRED_LOCATION_ACCURACY_METERS=30

# Phase 4 active challenge-response configuration.
CHALLENGE_COUNT=3
CHALLENGE_TIMEOUT_SECONDS=15
CHALLENGE_BASELINE_MS=500
CHALLENGE_SETTLING_MS=350
CHALLENGE_MIN_GYRO_SAMPLES=12
CHALLENGE_MAX_SENSOR_SAMPLES=5000
CHALLENGE_WINDOW_START_TOLERANCE_MS=1000
CHALLENGE_END_TOLERANCE_MS=500
CHALLENGE_MOVEMENT_THRESHOLD_RAD_S=0.18
CHALLENGE_SETTLE_THRESHOLD_RAD_S=0.10
CHALLENGE_SENSOR_AGREEMENT_TOLERANCE_DEGREES=20
CHALLENGE_SENSOR_CONFLICT_DEGREES=35
CHALLENGE_PASS_THRESHOLD=0.75
CHALLENGE_INCONCLUSIVE_THRESHOLD=0.50
CHALLENGE_MAX_RETRIES=3
CHALLENGE_FAILURE_LIMIT=2
ROTATION_MIN_TARGET_DEGREES=25
ROTATION_MAX_TARGET_DEGREES=55
TILT_MIN_TARGET_DEGREES=22
TILT_MAX_TARGET_DEGREES=45
ROTATION_RIGHT_SIGN=-1
TILT_DOWN_SIGN=1

# Reliable development default: evidence is outside PostgreSQL in a Docker volume.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/evidence
STORAGE_BUCKET=siteproof-evidence
STORAGE_REGION=us-east-1

# Optional S3-compatible/MinIO adapter: set STORAGE_BACKEND=s3 and use these values.
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=siteproof
STORAGE_SECRET_KEY=siteproof_minio_password
MINIO_ROOT_USER=siteproof
MINIO_ROOT_PASSWORD=siteproof_minio_password
